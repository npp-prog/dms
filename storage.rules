rules_version = '2';

// PDFs of documents and their signed versions: documents/{docId}/{n}-{kind}.pdf
// Who may read or add a file follows the document in Firestore (firestore.rules).
// Files are never replaced or deleted: each signature adds a new file, so every
// version stays on record.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function docOf(docId) {
      return firestore.get(/databases/(default)/documents/documents/$(docId)).data;
    }
    function isActive() {
      return request.auth != null && profile().active == true;
    }
    function isAdmin() {
      return profile().role in ['admin', 'superadmin', 'itadmin', 'records'];
    }
    function myOffice() {
      return profile().get('office', '');
    }
    function isHead() {
      return myOffice() != '' && profile().get('head', false) == true;
    }
    // Waiting in the user's office at a routed step (not at the preparer's own step).
    function heldByMyOffice(d) {
      return myOffice() != '' && d.get('currentOffice', '') == myOffice() && d.get('atPreparer', true) == false;
    }
    // Referred to this user by the office holding it (outside the route).
    function referredToMe(d) {
      return d.get('currentOffice', '') == 'person:' + request.auth.uid;
    }
    // Same as firestore.rules: the preparer, the office the document is waiting in, the office
    // head (every document of the office and every one routed through it), admins, and the person
    // it is referred to.
    function referredByMyOffice(d) {
      return myOffice() != '' && d.get('currentOffice', '').matches('person:.*')
        && d.workflow.get('referral', {}).get('fromOffice', '') == myOffice();
    }
    // The Records Officer (a position) reads every document's files.
    function isRecords() {
      return profile().role == 'records' || 'Records Officer' in profile().get('positions', []);
    }
    // The office head gave this user access to the document's folder (document type), or all;
    // not to a restricted document or folder (as in firestore.rules).
    // office '*': an administrator gave them these folders of every office. Storage rules may look
    // up only two Firestore documents (the profile and the document), so this reads the copy of the
    // user's folder access kept in their profile (folderGrant; blocked: the folders their office
    // restricted).
    function folderGranted(d) {
      let g = profile().get('folderGrant', null);
      return g != null && d.get('restricted', false) == false
        && (g.all == true || d.get('typeCode', '') in g.types)
        && (g.office == '*'
            || (myOffice() != '' && g.office == myOffice()
                && (d.get('office', '') == myOffice() || myOffice() in d.get('routeOffices', []))
                && !(d.get('typeCode', '') in g.get('blocked', []))));
    }
    // An editor (given by the office head, or by an administrator for every office): adds files as
    // the preparer does.
    function isEditor(d) {
      return (myOffice() != '' && d.get('office', '') == myOffice() && request.auth.uid in d.get('editors', []))
        || (folderGranted(d) && profile().folderGrant.get('edit', false) == true
            && (profile().folderGrant.office == '*' || d.get('office', '') == myOffice()));
    }
    // The current PDF, when it is public (as its public record says: lib/publicRecord.js), for any
    // signed-in user, without a third lookup.
    function publicCurrent(d, path) {
      return d.get('status', '') != 'cancelled' && d.get('workflow', {}).get('state', '') != 'cancelled'
        && d.get('typeSnapshot', {}).get('publicPdf', d.get('typeCode', '') != 'PAYROLL') != false
        && d.get('pdf', {}).get('files', []).size() > 0
        && d.pdf.files[d.pdf.files.size() - 1].path == path;
    }
    function canRead(d) {
      return isAdmin() || isRecords() || d.createdBy == request.auth.uid || heldByMyOffice(d) || referredToMe(d) || referredByMyOffice(d) || request.auth.uid in d.get('sharedWith', []) || request.auth.uid in d.get('referred', [])
        || (isHead() && (d.get('office', '') == myOffice() || d.get('currentOffice', '') == myOffice()
            || myOffice() in d.get('routeOffices', [])))
        || request.auth.uid in d.get('access', []) || folderGranted(d);
    }
    // At a routed step that names positions, only the people in them (and the office head).
    function holdsStepPosition(d) {
      return isHead() || d.workflow.steps[d.workflow.stage].get('positions', []).size() == 0
        || profile().get('positions', []).hasAny(d.workflow.steps[d.workflow.stage].get('positions', []));
    }
    // The preparer, or the office now holding the document (its head too).
    function canAdd(d) {
      return isAdmin() || (d.status != 'cancelled'
        && (d.createdBy == request.auth.uid || (heldByMyOffice(d) && holdsStepPosition(d)) || referredToMe(d)
            || (isHead() && d.get('currentOffice', '') == myOffice()) || isEditor(d)));
    }

    // The signatory's own PNPKI certificate file (signing.p12), kept so they sign with their password
    // only, and their signature mark (mark.png). Nobody else can read them, not even admins.
    // The certificate password is never stored.
    match /certificates/{uid}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && file.matches('signing\\.p12|mark\\.png');
      allow create, update: if request.auth != null && request.auth.uid == uid
        && ((file == 'signing.p12' && request.resource.size < 64 * 1024)
            || (file == 'mark.png' && request.resource.size < 2 * 1024 * 1024));
    }

    // The user's profile picture (My Profile): a square JPEG they replace or remove; signed-in
    // users see it (its address is in the directory).
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && file == 'photo.jpg'
        && request.resource.contentType == 'image/jpeg' && request.resource.size < 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // A circular's file (letter, executive order, memo): the offices it is sent to read it. The
    // circular is saved first, then its file is added by its sender.
    match /circulars/{id}/{file} {
      function circular() {
        return firestore.get(/databases/(default)/documents/circulars/$(id)).data;
      }
      allow read: if isActive() && (isAdmin() || circular().by == request.auth.uid || (myOffice() != '' && myOffice() in circular().toOffices));
      allow create: if resource == null && isActive() && circular().by == request.auth.uid
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)')
        && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Files shared in a community: its members read and add them.
    match /communities/{cid}/{file} {
      function community() {
        return firestore.get(/databases/(default)/documents/communities/$(cid)).data;
      }
      // Its members only (as its messages).
      allow read: if isActive() && request.auth.uid in community().members;
      // Documents and pictures only (no programs or scripts passed around).
      allow create: if resource == null && isActive() && request.auth.uid in community().members
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|gif)|text/(plain|csv)|application/(msword|vnd\\.ms-excel|vnd\\.ms-powerpoint|vnd\\.openxmlformats-officedocument\\..+|vnd\\.oasis\\.opendocument\\..+|zip)');
      allow update, delete: if false;
    }

    // Supporting documents uploaded to the checklist items (scanned PDFs, photos).
    match /documents/{docId}/attachments/{itemId}/{file} {
      // A supporting document's file (metadata dmsDoc: its id): also anyone, signed in or not, once
      // its public record (what its QR code opens) names it.
      // (Signed in: the profile and the document; not signed in: the public record only. Storage may
      // look up two documents.)
      allow read: if (request.auth != null && isActive() && canRead(docOf(docId)))
        || (request.auth == null && resource.metadata != null && resource.metadata.get('dmsDoc', '') != ''
            && firestore.get(/databases/(default)/documents/checks/$(resource.metadata.dmsDoc)).data.get('pdf', '') == 'documents/' + docId + '/attachments/' + itemId + '/' + file);
      allow create: if resource == null && isActive() && canAdd(docOf(docId))
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)')
        && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /documents/{docId}/{file} {
      // Anyone, signed in or not, may open the document's current PDF: the one its public record
      // (checks/{docId}, what the QR code opens) names. Earlier versions stay private.
      // (Signed in: the profile and the document; not signed in: the public record only. Storage may
      // look up two documents.)
      allow read: if (request.auth != null && isActive()
                      && (canRead(docOf(docId)) || publicCurrent(docOf(docId), 'documents/' + docId + '/' + file)))
        || (request.auth == null
            && firestore.get(/databases/(default)/documents/checks/$(docId)).data.get('pdf', '') == 'documents/' + docId + '/' + file);
      // resource == null: a new file only, never over an existing version.
      allow create: if resource == null && isActive() && canAdd(docOf(docId))
        && file.matches('[0-9]+-(generated|signed|esigned|uploaded|stamped|restored)\\.pdf')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
