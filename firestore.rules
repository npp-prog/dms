rules_version = '2';

// DMS - Document Management System, Municipal Government of Candoni.
// Personal data is processed under the Data Privacy Act of 2012 (RA 10173): each person reads only
// what their work needs (see the Privacy page). Roles: superadmin > admin > user. New accounts start inactive until an
// admin approves them. The superadmin is the owner's email below (keep it in
// sync with src/lib/owner.js); it is granted only once Firebase has verified
// the address (Google sign-in, or the email/password verification link).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function profile() {
      return get(profilePath()).data;
    }
    function isActive() {
      return hasProfile() && profile().active == true;
    }
    // Admin-level roles: Admin, IT Admin, Records Officer and the superadmin run the documents,
    // formats, workflow and folders of every office (src/lib/roles.js).
    function isAdmin() {
      return isActive() && profile().role in ['admin', 'superadmin', 'itadmin', 'records'];
    }
    // Users (add, approve, edit, invites): not the Records Officer.
    function managesUsers() {
      return isActive() && profile().role in ['admin', 'superadmin', 'itadmin'];
    }
    // An Admin gives the IT Admin and Records Officer roles (the superadmin gives every role).
    function givesStaffRoles() {
      return isActive() && profile().role == 'admin';
    }
    function rolesIManage() {
      return givesStaffRoles() ? ['user', 'payee', 'itadmin', 'records'] : ['user', 'payee'];
    }
    // Settings: the superadmin and Admin; not IT Admin nor the Records Officer.
    function managesSettings() {
      return isActive() && profile().role in ['admin', 'superadmin'];
    }
    function isSuper() {
      return isActive() && profile().role == 'superadmin';
    }
    // The Records Officer (a role, Users) keeps the records and the archive.
    function isRecords() {
      return isActive() && profile().role == 'records';
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['npp@mgocandoniaccounting.org'];
    }
    // The office the user belongs to (assigned by an admin); '' if none yet.
    function myOffice() {
      return profile().get('office', '');
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }
    // A supplier or payee (role 'payee'): not LGU personnel. They see and sign the documents
    // referred to them, send them back (and still read them afterwards), and use Messages; no
    // communities, circulars, checklists, tracking or documents of their own.
    function isStaff() {
      return isActive() && profile().role != 'payee';
    }
    // The head of the user's office (Users: Office head).
    function isOfficeHead() {
      return isActive() && myOffice() != '' && profile().get('head', false) == true;
    }

    // ---- Notifications to a user (updates on their documents, circulars, communities) ----
    // Anyone active may send one to anyone, as themselves; only the user reads them, marks them
    // read or deletes them. Each is also emailed to them (netlify/functions/email.mjs).
    match /users/{uid}/notifications/{nid} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      // its sender may read it back (to email it: netlify/functions/email.mjs)
      allow get: if isActive() && resource.data.from == request.auth.uid;
      allow create: if isActive() && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'text', 'link', 'from', 'fromName', 'at', 'read'])
        && request.resource.data.kind in ['document', 'circular', 'community', 'work', 'mention', 'reminder']
        // signed with the sender's own name (as in their profile), never someone else's
        && request.resource.data.fromName in [profile().get('displayName', ''), profile().get('email', '')]
        && request.resource.data.link is string && request.resource.data.link.matches('^/[A-Za-z0-9/_-]*$')
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.read == false;
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ---- Circulars: letters, executive orders, memos... sent by an office head to some or all
    // offices. Each office it is sent to marks it received (only its own entry in receipts). ----
    match /circulars/{id} {
      allow read: if isStaff() && (isAdmin() || resource.data.by == request.auth.uid
        || (myOffice() != '' && myOffice() in resource.data.toOffices));
      allow create: if (isOfficeHead() || isAdmin())
        && request.resource.data.by == request.auth.uid
        && (isAdmin() || request.resource.data.fromOffice == myOffice())
        && request.resource.data.keys().hasOnly(['title', 'kind', 'note', 'file', 'doc', 'fromOffice', 'by', 'byName', 'at', 'all', 'toOffices', 'receipts'])
        && request.resource.data.receipts.size() == 0
        && request.resource.data.toOffices.size() > 0;
      allow update: if isStaff()
        && ((resource.data.by == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['file']))
          || (myOffice() != '' && myOffice() in resource.data.toOffices
             && !(myOffice() in resource.data.receipts)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipts'])
             && request.resource.data.receipts.diff(resource.data.receipts).affectedKeys().hasOnly([myOffice()])
             && request.resource.data.receipts[myOffice()].uid == request.auth.uid));
      allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
    }

    // ---- Communities: groups any user creates for their office, with members from any office. The
    // office administers it (the creator, the office head, administrators): name, members. ----
    match /communities/{cid} {
      function manages(c) {
        return isAdmin() || c.createdBy == request.auth.uid || (isOfficeHead() && c.office == myOffice());
      }
      function isMember(c) {
        return request.auth.uid in c.members;
      }
      function chatOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastBy', 'readAt'])
          && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.get('lastBy', '') == resource.data.get('lastBy', '') || request.resource.data.lastBy == request.auth.uid);
      }
      allow read: if isStaff() && (isMember(resource.data) || manages(resource.data));
      // Any active user creates one, for their office.
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || request.resource.data.office == myOffice())
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['name', 'description', 'office', 'createdBy', 'members', 'names', 'createdAt', 'lastText', 'lastAt', 'lastBy', 'readAt']);
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['name', 'description', 'office', 'createdBy', 'members', 'names', 'createdAt', 'lastText', 'lastAt', 'lastBy', 'readAt'])
        && unchanged(['office', 'createdBy', 'createdAt'])
        && (manages(resource.data)
          || (isMember(resource.data) && chatOnly())
          // a member leaves
          || (isMember(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
              && resource.data.members.removeAll([request.auth.uid]) == request.resource.data.members
              && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if isStaff() && manages(resource.data);
      match /messages/{mid} {
        function community() {
          return get(/databases/$(database)/documents/communities/$(cid)).data;
        }
        // Only its members read the messages: those who manage it (its office head, administrators)
        // change its name and members, but a group's conversation is its members' own.
        allow read: if isStaff() && exists(/databases/$(database)/documents/communities/$(cid))
          && isMember(community());
        allow create: if isStaff() && request.resource.data.from == request.auth.uid
          && isMember(getAfter(/databases/$(database)/documents/communities/$(cid)).data)
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'text', 'file', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        // only its sender deletes a message
        allow delete: if isStaff() && resource.data.from == request.auth.uid;
        allow update: if false;
      }
    }

    // ---- System metadata ----
    match /meta/settings {
      // (also a new account waiting for approval: it chooses its office from the list)
      allow read: if signedIn();
      allow write: if managesSettings();
    }
    // The privacy notice's contacts (the Data Protection Officer): public, like the notice itself.
    match /meta/privacy {
      allow read: if true;
      allow write: if managesSettings();
    }
    // DMS account numbers: the last one issued (lib/accountNo.js). It only goes up.
    match /meta/accountNumbers {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is int && request.resource.data.last > 0 && request.resource.data.last <= 999999;
      allow update: if isActive() && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is int && request.resource.data.last > resource.data.last && request.resource.data.last <= 999999;
    }
    // accountNumbers/{no}: whose number it is. Created once, with the user's profile taking that
    // number in the same write (see users: accountNoGiven); never changed or removed.
    match /accountNumbers/{no} {
      allow get: if isActive();
      allow create: if isActive() && no.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid is string
        && (request.resource.data.uid == request.auth.uid || managesUsers())
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('accountNo', '') == no;
      allow update, delete: if false;
    }
    // The Archive's settings (backup devices, how often to back up): the Records Officer keeps them.
    match /meta/archive {
      allow read: if isRecords() || isAdmin();
      allow write: if isRecords() || isAdmin();
    }
    // Log of the archive backups (who, when, to which device, how many documents). Never changed.
    match /backups/{id} {
      allow read: if isRecords() || isAdmin();
      allow create: if (isRecords() || isAdmin()) && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Online status (Messages): each user writes their own; turned off: hidden ----
    match /presence/{uid} {
      allow read: if isActive();
      allow write: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'hidden'])
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && request.resource.data.hidden is bool;
    }

    // ---- Messages between two users: only the two of them read or write them ----
    // The conversation's id is the two uids, sorted, joined by '_'.
    match /conversations/{cid} {
      function members() {
        return request.resource.data.members;
      }
      allow read: if isActive() && request.auth.uid in resource.data.members;
      allow create: if isActive() && members().size() == 2 && request.auth.uid in members()
        && members()[0] < members()[1] && cid == members()[0] + '_' + members()[1]
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastText', 'lastAt', 'lastBy', 'readAt'])
        && request.resource.data.lastBy == request.auth.uid;
      allow update: if isActive() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastText', 'lastAt', 'lastBy', 'readAt'])
        && (request.resource.data.get('lastBy', '') == resource.data.get('lastBy', '') || request.resource.data.lastBy == request.auth.uid);
      match /messages/{mid} {
        allow read: if isActive() && exists(/databases/$(database)/documents/conversations/$(cid))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members;
        allow create: if isActive() && request.resource.data.from == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'doc', 'replyTo'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          // a DMS document sent in it (a link: it opens only for those who may see it), and the
          // message it replies to (a short quote)
          && (request.resource.data.text.size() > 0 || 'doc' in request.resource.data)
          && (!('doc' in request.resource.data) || (request.resource.data.doc.keys().hasOnly(['id', 'controlNo', 'typeCode', 'title'])
              && request.resource.data.doc.id is string && request.resource.data.doc.get('title', '') is string && request.resource.data.doc.get('title', '').size() <= 200))
          && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo.keys().hasOnly(['id', 'from', 'name', 'text'])
              && request.resource.data.replyTo.id is string && request.resource.data.replyTo.get('text', '') is string && request.resource.data.replyTo.get('text', '').size() <= 200));
        allow update, delete: if false;
      }
    }

    // ---- Personal notes and reminders (Dashboard): only their owner reads or writes them ----
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      allow create, update: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'due', 'done', 'createdAt', 'doneAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
    }

    // ---- Users added in advance by an administrator (Users → + Add user), keyed by their email in
    // lower case: on their first sign-in with that email, verified, they get this office, role and
    // positions, already active. ----
    match /invites/{email} {
      // the person themself may read theirs (to know they are expected)
      allow read: if managesUsers() || (signedIn() && request.auth.token.email.lower() == email);
      allow create, update: if managesUsers() && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'office', 'role', 'positions', 'head', 'canRefer', 'by', 'byName', 'at'])
        && request.resource.data.email == email
        && request.resource.data.positions is list && request.resource.data.head is bool && request.resource.data.canRefer is bool
        // Admin only by the superadmin; IT Admin and Records Officer by the superadmin or an Admin;
        // a third party has no office
        && (request.resource.data.role == 'user' || (isSuper() && request.resource.data.role in ['admin', 'itadmin', 'records'])
            || (givesStaffRoles() && request.resource.data.role in ['itadmin', 'records'])
            || (request.resource.data.role == 'payee' && request.resource.data.office == '' && request.resource.data.head == false
                && request.resource.data.positions.size() == 0 && request.resource.data.canRefer == false));
      allow delete: if managesUsers();
    }

    // ---- User profiles ----
    match /users/{uid} {
      // The administrator added this email in advance, and Firebase has verified that the person
      // signing in owns it (Google sign-in, or the link emailed at registration).
      // My Profile: short texts; the picture is in this project's Storage or the Google account's.
      function ownDetailsOk(d) {
        return d.get('position', '') is string && d.get('position', '').size() <= 120
          && d.get('idNo', '') is string && d.get('idNo', '').size() <= 40
          && d.get('photo', '') is string && d.get('photo', '').size() <= 1000
          && (d.get('photo', '') == ''
              || d.photo.matches('https://(firebasestorage[.]googleapis[.]com|[a-z0-9-]+[.]googleusercontent[.]com)/.*')
              || d.photo.matches('http://(127[.]0[.]0[.]1|localhost):9199/.*'));
      }
      // The DMS account number (lib/accountNo.js): set once, six digits, claimed in
      // accountNumbers/{no} in the same write (a number can be claimed only once); never changed.
      function accountNoKept() {
        return request.resource.data.get('accountNo', '') == resource.data.get('accountNo', '');
      }
      function accountNoGiven() {
        let no = request.resource.data.get('accountNo', '');
        return resource.data.get('accountNo', '') == '' && resource.data.active == true
          && no is string && no.matches('^[0-9]{6}$')
          && !exists(/databases/$(database)/documents/accountNumbers/$(no))
          && getAfter(/databases/$(database)/documents/accountNumbers/$(no)).data.uid == uid;
      }
      function invitePath() {
        return /databases/$(database)/documents/invites/$(request.auth.token.email.lower());
      }
      function invited() {
        return request.auth.token.email_verified == true && exists(invitePath());
      }
      // The profile is exactly what the invitation says, and active.
      function asInvited(d) {
        let i = get(invitePath()).data;
        return d.role == i.role && d.get('office', '') == i.office && d.get('head', false) == i.head
          && d.get('positions', []) == i.positions && d.get('canRefer', false) == i.canRefer && d.active == true;
      }
      // folderGrant: a copy of folderAccess/{uid} (plus blocked: the folders the office restricted),
      // so that Storage, which may look up only two documents, checks folder access from the
      // profile. Written with folderAccess, by whoever may give it; never by the user themselves.
      function grantCopyOk() {
        let fa = /databases/$(database)/documents/folderAccess/$(uid);
        let g = request.resource.data.get('folderGrant', null);
        return (isAdmin() || isRecords() || (isOfficeHead() && resource.data.get('office', '') == myOffice()))
          && (existsAfter(fa)
            ? (g != null && g.keys().hasOnly(['office', 'all', 'types', 'edit', 'blocked'])
               && g.office == getAfter(fa).data.office && g.all == getAfter(fa).data.all
               && g.types == getAfter(fa).data.types && g.edit == getAfter(fa).data.get('edit', false)
               && g.blocked is list)
            : g == null);
      }
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && ((
          // Only what registration writes: no positions or routing rights.
          request.resource.data.keys().hasOnly(['email', 'displayName', 'office', 'requestedOffice', 'role', 'active', 'createdAt'])
          // The office is assigned by an admin, never chosen by the user.
          && request.resource.data.get('office', '') == ''
          && request.resource.data.get('head', false) == false && (
          // Regular self-registration: inactive user awaiting approval.
          (request.resource.data.role == 'user' && request.resource.data.active == false)
          // The owner's verified email: superadmin.
          || (request.resource.data.role == 'superadmin' && request.resource.data.active == true && isOwnerEmail())
        ))
        // Added in advance by an administrator: as the invitation says.
        || (invited()
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'office', 'requestedOffice', 'role', 'active', 'createdAt', 'positions', 'head', 'canRefer'])
          && asInvited(request.resource.data)));

      allow update: if
        // Superadmin manages everyone (but cannot lock themselves out).
        // (The copy of their folder access only as folderAccess says: grantCopyOk.)
        (isSuper() && (request.auth.uid != uid || unchanged(['role', 'active']))
            && (unchanged(['folderGrant']) || grantCopyOk()) && (accountNoKept() || accountNoGiven()))
        // Admin and IT Admin approve/deactivate and edit regular users; an Admin also IT Admins and
        // Records Officers, and gives those roles (never Admin or superadmin).
        || (managesUsers() && request.auth.uid != uid
            && resource.data.role in rolesIManage() && request.resource.data.role in rolesIManage()
            && (unchanged(['folderGrant']) || grantCopyOk()) && (accountNoKept() || accountNoGiven()))
        // Anyone may edit their own name, position (job title), ID no. and profile picture (not
        // their office, office head, workflow positions or routing to any person: they decide what
        // they can see and do).
        || (request.auth.uid == uid && unchanged(['role', 'active', 'email', 'office', 'head', 'offices', 'canRefer', 'positions', 'folderGrant'])
            && accountNoKept() && ownDetailsOk(request.resource.data))
        // Their DMS account number, once (and nothing else).
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountNo']) && accountNoGiven())
        // Switching the office they act for: only to one of the offices an administrator gave them
        // (offices: [{office, head}]), with its office-head setting; nothing else changes.
        || (request.auth.uid == uid && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['office', 'head'])
            && {'office': request.resource.data.get('office', ''), 'head': request.resource.data.get('head', false)} in resource.data.get('offices', []))
        // The copy of their folder access (see grantCopyOk), and nothing else.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folderGrant']) && grantCopyOk())
        // Added in advance: a pending account (registered before verifying its email, or before the
        // administrator added it) takes what the invitation says once the email is verified.
        || (request.auth.uid == uid && resource.data.active == false && invited()
            && unchanged(['email', 'createdAt', 'folderGrant', 'offices', 'accountNo']) && asInvited(request.resource.data))
        // The owner becomes superadmin once their email is verified.
        || (request.auth.uid == uid && isOwnerEmail()
            && request.resource.data.role == 'superadmin' && request.resource.data.active == true
            && unchanged(['email', 'office', 'accountNo']));

      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // ---- Document types (formats, guided steps, processing guides) ----
    match /documentTypes/{typeId} {
      allow read: if isActive();
      // Document Types and Workflow: administrators, not the Records Officer.
      allow write: if isAdmin() && profile().role != 'records';
    }

    // ---- Checklist library (requirements per transaction type, keyed by checklist no.) ----
    match /checklists/{code} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Prepared documents ----
    // A user sees the documents they prepared, and the documents waiting in their office to be
    // received, signed and released (not a colleague's document still at the preparer's step).
    // The office head sees every document of the office and every document routed through it.
    // Admins see all.
    match /documents/{docId} {
      function holder() {
        return resource.data.get('currentOffice', '');
      }
      function isHead() {
        return myOffice() != '' && profile().get('head', false) == true;
      }
      // Waiting in the user's office at a routed step (atPreparer: the preparer's own step).
      function heldByMyOffice() {
        return myOffice() != '' && holder() == myOffice()
          && resource.data.get('atPreparer', true) == false;
      }
      // Referred by the office holding it to this user (outside the route): they receive it, act
      // (e.g. sign) and send it back.
      function referredToMe() {
        return holder() == 'person:' + request.auth.uid;
      }
      // The route step names who in the office acts (positions): the user holds one, or it names
      // none. The office head always may.
      // (With the profile values docUpdateOk reads once: each profile() call rebuilds its
      // path, and every expression counts toward the limit of 1000 a request may evaluate.)
      function holdsStepPosition(head, p) {
        let wanted = resource.data.workflow.steps[resource.data.workflow.stage].get('positions', []);
        return head || wanted.size() == 0 || p.get('positions', []).hasAny(wanted);
      }
      // The office that referred it keeps seeing it while it is out (read only).
      function referredByMyOffice() {
        return myOffice() != '' && holder().matches('person:.*')
          && resource.data.workflow.get('referral', {}).get('fromOffice', '') == myOffice();
      }
      // Referring a document to a person: admins, and users allowed to route to any person.
      // Or released to a third-party step of its route: to the person the preparer designated.
      function referralAllowed(admin, p) {
        return !request.resource.data.get('currentOffice', '').matches('person:.*')
          || resource.data.get('currentOffice', '').matches('person:.*')
          || admin || p.get('canRefer', false) == true
          || (request.resource.data.workflow.steps[request.resource.data.workflow.stage].get('office', '') == '@third-party'
              && request.resource.data.currentOffice == 'person:' + request.resource.data.workflow.steps[request.resource.data.workflow.stage].get('party', {}).get('uid', '-'));
      }
      // The fields the current route step assigns on receiving (e.g. dvNo and dvDate) or fills in
      // (e.g. checkNo, checkDate, bankName), if any.
      function assignedKeys() {
        let step = resource.data.workflow.steps[resource.data.workflow.stage];
        let assign = step.get('assign', {});
        return [assign.get('field', '-'), assign.get('dateField', '-')].concat(step.get('fills', []));
      }
      function headSees() {
        return isHead() && (resource.data.get('office', '') == myOffice() || holder() == myOffice()
          || myOffice() in resource.data.get('routeOffices', []));
      }
      // Staff of an office the document has reached on its route (not the office that prepared it,
      // whose staff see only their own documents unless given access): they open it and add
      // supplemental documents.
      function routeStaff() {
        return myOffice() != '' && myOffice() != resource.data.get('office', '')
          && myOffice() in resource.data.get('routeOffices', []);
      }
      // Signature requests (lib/signRequest.js): the person whose turn it is signs where their box
