rules_version = '2';

// DMS - Document Management System, Municipal Government of Candoni.
// Personal data is processed under the Data Privacy Act of 2012 (RA 10173): each person reads only
// what their work needs (see the Privacy page). Roles: superadmin > admin > user. New accounts start inactive until an
// admin approves them. The superadmin is the owner's email below (keep it in
// sync with src/lib/owner.js); it is granted only once Firebase has verified
// the address (Google sign-in, or the email/password verification link).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function profile() {
      return get(profilePath()).data;
    }
    function isActive() {
      return hasProfile() && profile().active == true;
    }
    // Admin-level roles: Admin, IT Admin, Records Officer and the superadmin run the documents,
    // formats, workflow and folders of every office (src/lib/roles.js).
    function isAdmin() {
      return isActive() && profile().role in ['admin', 'superadmin', 'itadmin', 'records'];
    }
    // Users (add, approve, edit, invites): not the Records Officer.
    function managesUsers() {
      return isActive() && profile().role in ['admin', 'superadmin', 'itadmin'];
    }
    // Settings: the superadmin (and Admin); not IT Admin nor the Records Officer.
    function managesSettings() {
      return isActive() && profile().role in ['admin', 'superadmin'];
    }
    function isSuper() {
      return isActive() && profile().role == 'superadmin';
    }
    // The Records Officer (a position, Users) sees every document, to keep and download the records.
    function isRecords() {
      return isActive() && (profile().role == 'records' || 'Records Officer' in profile().get('positions', []));
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['npp@mgocandoniaccounting.org'];
    }
    // The office the user belongs to (assigned by an admin); '' if none yet.
    function myOffice() {
      return profile().get('office', '');
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }
    // A supplier or payee (role 'payee'): not LGU personnel. They see and sign the documents
    // referred to them, send them back (and still read them afterwards), and use Messages; no
    // communities, circulars, checklists, tracking or documents of their own.
    function isStaff() {
      return isActive() && profile().role != 'payee';
    }
    // The head of the user's office (Users: Office head).
    function isOfficeHead() {
      return isActive() && myOffice() != '' && profile().get('head', false) == true;
    }

    // ---- Notifications to a user (updates on their documents, circulars, communities) ----
    // Anyone active may send one to anyone, as themselves; only the user reads them, marks them
    // read or deletes them. Each is also emailed to them (netlify/functions/email.mjs).
    match /users/{uid}/notifications/{nid} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      // its sender may read it back (to email it: netlify/functions/email.mjs)
      allow get: if isActive() && resource.data.from == request.auth.uid;
      allow create: if isActive() && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'text', 'link', 'from', 'fromName', 'at', 'read'])
        && request.resource.data.kind in ['document', 'circular', 'community']
        // signed with the sender's own name (as in their profile), never someone else's
        && request.resource.data.fromName in [profile().get('displayName', ''), profile().get('email', '')]
        && request.resource.data.link is string && request.resource.data.link.matches('^/[A-Za-z0-9/_-]*$')
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.read == false;
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ---- Circulars: letters, executive orders, memos... sent by an office head to some or all
    // offices. Each office it is sent to marks it received (only its own entry in receipts). ----
    match /circulars/{id} {
      allow read: if isStaff() && (isAdmin() || resource.data.by == request.auth.uid
        || (myOffice() != '' && myOffice() in resource.data.toOffices));
      allow create: if (isOfficeHead() || isAdmin())
        && request.resource.data.by == request.auth.uid
        && (isAdmin() || request.resource.data.fromOffice == myOffice())
        && request.resource.data.keys().hasOnly(['title', 'kind', 'note', 'file', 'doc', 'fromOffice', 'by', 'byName', 'at', 'all', 'toOffices', 'receipts'])
        && request.resource.data.receipts.size() == 0
        && request.resource.data.toOffices.size() > 0;
      allow update: if isStaff()
        && ((resource.data.by == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['file']))
          || (myOffice() != '' && myOffice() in resource.data.toOffices
             && !(myOffice() in resource.data.receipts)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipts'])
             && request.resource.data.receipts.diff(resource.data.receipts).affectedKeys().hasOnly([myOffice()])
             && request.resource.data.receipts[myOffice()].uid == request.auth.uid));
      allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
    }

    // ---- Communities: groups any user creates for their office, with members from any office. The
    // office administers it (the creator, the office head, administrators): name, members. ----
    match /communities/{cid} {
      function manages(c) {
        return isAdmin() || c.createdBy == request.auth.uid || (isOfficeHead() && c.office == myOffice());
      }
      function isMember(c) {
        return request.auth.uid in c.members;
      }
      function chatOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastBy', 'readAt'])
          && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.get('lastBy', '') == resource.data.get('lastBy', '') || request.resource.data.lastBy == request.auth.uid);
      }
      allow read: if isStaff() && (isMember(resource.data) || manages(resource.data));
      // Any active user creates one, for their office.
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || request.resource.data.office == myOffice())
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['name', 'description', 'office', 'createdBy', 'members', 'names', 'createdAt', 'lastText', 'lastAt', 'lastBy', 'readAt']);
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['name', 'description', 'office', 'createdBy', 'members', 'names', 'createdAt', 'lastText', 'lastAt', 'lastBy', 'readAt'])
        && unchanged(['office', 'createdBy', 'createdAt'])
        && (manages(resource.data)
          || (isMember(resource.data) && chatOnly())
          // a member leaves
          || (isMember(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
              && resource.data.members.removeAll([request.auth.uid]) == request.resource.data.members
              && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if isStaff() && manages(resource.data);
      match /messages/{mid} {
        function community() {
          return get(/databases/$(database)/documents/communities/$(cid)).data;
        }
        // Only its members read the messages: those who manage it (its office head, administrators)
        // change its name and members, but a group's conversation is its members' own.
        allow read: if isStaff() && exists(/databases/$(database)/documents/communities/$(cid))
          && isMember(community());
        allow create: if isStaff() && request.resource.data.from == request.auth.uid
          && isMember(getAfter(/databases/$(database)/documents/communities/$(cid)).data)
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'text', 'file', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if isStaff() && (resource.data.from == request.auth.uid || manages(community()));
        allow update: if false;
      }
    }

    // ---- System metadata ----
    match /meta/settings {
      allow read: if isActive();
      allow write: if managesSettings();
    }
    // The privacy notice's contacts (the Data Protection Officer): public, like the notice itself.
    match /meta/privacy {
      allow read: if true;
      allow write: if managesSettings();
    }
    // The Archive's settings (backup devices, how often to back up): the Records Officer keeps them.
    match /meta/archive {
      allow read: if isRecords() || isAdmin();
      allow write: if isRecords() || isAdmin();
    }
    // Log of the archive backups (who, when, to which device, how many documents). Never changed.
    match /backups/{id} {
      allow read: if isRecords() || isAdmin();
      allow create: if (isRecords() || isAdmin()) && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Messages between two users: only the two of them read or write them ----
    // The conversation's id is the two uids, sorted, joined by '_'.
    match /conversations/{cid} {
      function members() {
        return request.resource.data.members;
      }
      allow read: if isActive() && request.auth.uid in resource.data.members;
      allow create: if isActive() && members().size() == 2 && request.auth.uid in members()
        && members()[0] < members()[1] && cid == members()[0] + '_' + members()[1]
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastText', 'lastAt', 'lastBy', 'readAt'])
        && request.resource.data.lastBy == request.auth.uid;
      allow update: if isActive() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastText', 'lastAt', 'lastBy', 'readAt'])
        && (request.resource.data.get('lastBy', '') == resource.data.get('lastBy', '') || request.resource.data.lastBy == request.auth.uid);
      match /messages/{mid} {
        allow read: if isActive() && exists(/databases/$(database)/documents/conversations/$(cid))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members;
        allow create: if isActive() && request.resource.data.from == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ---- Personal notes and reminders (Dashboard): only their owner reads or writes them ----
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      allow create, update: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'due', 'done', 'createdAt', 'doneAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
    }

    // ---- Users added in advance by an administrator (Users → + Add user), keyed by their email in
    // lower case: on their first sign-in with that email, verified, they get this office, role and
    // positions, already active. ----
    match /invites/{email} {
      // the person themself may read theirs (to know they are expected)
      allow read: if managesUsers() || (signedIn() && request.auth.token.email.lower() == email);
      allow create, update: if managesUsers() && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'office', 'role', 'positions', 'head', 'canRefer', 'by', 'byName', 'at'])
        && request.resource.data.email == email
        && request.resource.data.positions is list && request.resource.data.head is bool && request.resource.data.canRefer is bool
        // administrators only by the superadmin; a third party has no office
        && (request.resource.data.role == 'user' || (isSuper() && request.resource.data.role in ['admin', 'itadmin', 'records'])
            || (request.resource.data.role == 'payee' && request.resource.data.office == '' && request.resource.data.head == false
                && request.resource.data.positions.size() == 0 && request.resource.data.canRefer == false));
      allow delete: if managesUsers();
    }

    // ---- User profiles ----
    match /users/{uid} {
      // The administrator added this email in advance, and Firebase has verified that the person
      // signing in owns it (Google sign-in, or the link emailed at registration).
      // My Profile: short texts; the picture is in this project's Storage or the Google account's.
      function ownDetailsOk(d) {
        return d.get('position', '') is string && d.get('position', '').size() <= 120
          && d.get('idNo', '') is string && d.get('idNo', '').size() <= 40
          && d.get('photo', '') is string && d.get('photo', '').size() <= 1000
          && (d.get('photo', '') == ''
              || d.photo.matches('https://(firebasestorage[.]googleapis[.]com|[a-z0-9-]+[.]googleusercontent[.]com)/.*')
              || d.photo.matches('http://(127[.]0[.]0[.]1|localhost):9199/.*'));
      }
      function invitePath() {
        return /databases/$(database)/documents/invites/$(request.auth.token.email.lower());
      }
      function invited() {
        return request.auth.token.email_verified == true && exists(invitePath());
      }
      // The profile is exactly what the invitation says, and active.
      function asInvited(d) {
        let i = get(invitePath()).data;
        return d.role == i.role && d.get('office', '') == i.office && d.get('head', false) == i.head
          && d.get('positions', []) == i.positions && d.get('canRefer', false) == i.canRefer && d.active == true;
      }
      // folderGrant: a copy of folderAccess/{uid} (plus blocked: the folders the office restricted),
      // so that Storage, which may look up only two documents, checks folder access from the
      // profile. Written with folderAccess, by whoever may give it; never by the user themselves.
      function grantCopyOk() {
        let fa = /databases/$(database)/documents/folderAccess/$(uid);
        let g = request.resource.data.get('folderGrant', null);
        return (isAdmin() || isRecords() || (isOfficeHead() && resource.data.get('office', '') == myOffice()))
          && (existsAfter(fa)
            ? (g != null && g.keys().hasOnly(['office', 'all', 'types', 'edit', 'blocked'])
               && g.office == getAfter(fa).data.office && g.all == getAfter(fa).data.all
               && g.types == getAfter(fa).data.types && g.edit == getAfter(fa).data.get('edit', false)
               && g.blocked is list)
            : g == null);
      }
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && ((
          // Only what registration writes: no positions (e.g. Records Officer) or routing rights.
          request.resource.data.keys().hasOnly(['email', 'displayName', 'office', 'requestedOffice', 'role', 'active', 'createdAt'])
          // The office is assigned by an admin, never chosen by the user.
          && request.resource.data.get('office', '') == ''
          && request.resource.data.get('head', false) == false && (
          // Regular self-registration: inactive user awaiting approval.
          (request.resource.data.role == 'user' && request.resource.data.active == false)
          // The owner's verified email: superadmin.
          || (request.resource.data.role == 'superadmin' && request.resource.data.active == true && isOwnerEmail())
        ))
        // Added in advance by an administrator: as the invitation says.
        || (invited()
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'office', 'requestedOffice', 'role', 'active', 'createdAt', 'positions', 'head', 'canRefer'])
          && asInvited(request.resource.data)));

      allow update: if
        // Superadmin manages everyone (but cannot lock themselves out).
        // (The copy of their folder access only as folderAccess says: grantCopyOk.)
        (isSuper() && (request.auth.uid != uid || unchanged(['role', 'active']))
            && (unchanged(['folderGrant']) || grantCopyOk()))
        // Admin and IT Admin approve/deactivate and edit regular users only.
        || (managesUsers() && request.auth.uid != uid
            && resource.data.role in ['user', 'payee'] && request.resource.data.role in ['user', 'payee']
            && (unchanged(['folderGrant']) || grantCopyOk()))
        // Anyone may edit their own name, position (job title), ID no. and profile picture (not
        // their office, office head, workflow positions or routing to any person: they decide what
        // they can see and do).
        || (request.auth.uid == uid && unchanged(['role', 'active', 'email', 'office', 'head', 'canRefer', 'positions', 'folderGrant'])
            && ownDetailsOk(request.resource.data))
        // The copy of their folder access (see grantCopyOk), and nothing else.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folderGrant']) && grantCopyOk())
        // Added in advance: a pending account (registered before verifying its email, or before the
        // administrator added it) takes what the invitation says once the email is verified.
        || (request.auth.uid == uid && resource.data.active == false && invited()
            && unchanged(['email', 'createdAt', 'folderGrant']) && asInvited(request.resource.data))
        // The owner becomes superadmin once their email is verified.
        || (request.auth.uid == uid && isOwnerEmail()
            && request.resource.data.role == 'superadmin' && request.resource.data.active == true
            && unchanged(['email', 'office']));

      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // ---- Document types (formats, guided steps, processing guides) ----
    match /documentTypes/{typeId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- Checklist library (requirements per transaction type, keyed by checklist no.) ----
    match /checklists/{code} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Prepared documents ----
    // A user sees the documents they prepared, and the documents waiting in their office to be
    // received, signed and released (not a colleague's document still at the preparer's step).
    // The office head sees every document of the office and every document routed through it.
    // Admins see all.
    match /documents/{docId} {
      function holder() {
        return resource.data.get('currentOffice', '');
      }
      function isHead() {
        return myOffice() != '' && profile().get('head', false) == true;
      }
      // Waiting in the user's office at a routed step (atPreparer: the preparer's own step).
      function heldByMyOffice() {
        return myOffice() != '' && holder() == myOffice()
          && resource.data.get('atPreparer', true) == false;
      }
      // Referred by the office holding it to this user (outside the route): they receive it, act
      // (e.g. sign) and send it back.
      function referredToMe() {
        return holder() == 'person:' + request.auth.uid;
      }
      // The route step names who in the office acts (positions): the user holds one, or it names
      // none. The office head always may.
      function holdsStepPosition() {
        let wanted = resource.data.workflow.steps[resource.data.workflow.stage].get('positions', []);
        return isHead() || wanted.size() == 0 || profile().get('positions', []).hasAny(wanted);
      }
      // The office that referred it keeps seeing it while it is out (read only).
      function referredByMyOffice() {
        return myOffice() != '' && holder().matches('person:.*')
          && resource.data.workflow.get('referral', {}).get('fromOffice', '') == myOffice();
      }
      // Referring a document to a person: admins, and users allowed to route to any person.
      // Or released to a third-party step of its route: to the person the preparer designated.
      function referralAllowed() {
        return !request.resource.data.get('currentOffice', '').matches('person:.*')
          || resource.data.get('currentOffice', '').matches('person:.*')
          || isAdmin() || profile().get('canRefer', false) == true
          || (request.resource.data.workflow.steps[request.resource.data.workflow.stage].get('office', '') == '@third-party'
              && request.resource.data.currentOffice == 'person:' + request.resource.data.workflow.steps[request.resource.data.workflow.stage].get('party', {}).get('uid', '-'));
      }
      // The fields the current route step assigns on receiving (e.g. dvNo and dvDate) or fills in
      // (e.g. checkNo, checkDate, bankName), if any.
      function assignedKeys() {
        let step = resource.data.workflow.steps[resource.data.workflow.stage];
        let assign = step.get('assign', {});
        return [assign.get('field', '-'), assign.get('dateField', '-')].concat(step.get('fills', []));
      }
      function headSees() {
        return isHead() && (resource.data.get('office', '') == myOffice() || holder() == myOffice()
          || myOffice() in resource.data.get('routeOffices', []));
      }
      // The office head (or an administrator or the Records Officer) gave this user, of the same
      // office, access to this folder (document type) of the office's documents, or to all of them
      // (Folders: Access). Not to a restricted document, nor to a folder the office restricted.
      // office '*': an administrator gave them these folders of every office (any user).
      function folderGranted() {
        let g = /databases/$(database)/documents/folderAccess/$(request.auth.uid);
        let r = /databases/$(database)/documents/folderRules/$(myOffice());
        return exists(g)
          && (get(g).data.all == true || resource.data.get('typeCode', '') in get(g).data.types)
          && resource.data.get('restricted', false) == false
          && (get(g).data.office == '*'
              || (myOffice() != '' && get(g).data.office == myOffice()
                  && (resource.data.get('office', '') == myOffice() || myOffice() in resource.data.get('routeOffices', []))
                  && !(exists(r) && resource.data.get('typeCode', '') in get(r).data.get('restricted', []))));
      }
      // Editor (given by the office head, of this document or its folder; or by an administrator,
      // of folders of every office): does what its preparer does.
      function actsAsPreparer() {
        return resource.data.createdBy == request.auth.uid
          || (myOffice() != '' && resource.data.get('office', '') == myOffice()
              && request.auth.uid in resource.data.get('editors', []))
          || (folderGranted() && get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.get('edit', false) == true
              && (get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.office == '*'
                  || resource.data.get('office', '') == myOffice()));
      }
      // The workflow fields change only through the office holding the document.
      function workflowUntouched() {
        return unchanged(['workflow', 'currentOffice', 'routeOffices', 'atPreparer']);
      }
      allow read: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin() || heldByMyOffice() || headSees() || referredToMe() || referredByMyOffice() || isRecords()
            // forwarded to this user, or referred to them (also after they sent it back)
            || request.auth.uid in resource.data.get('sharedWith', [])
            || request.auth.uid in resource.data.get('referred', [])
            // given access by the office head (this document, or its folder)
            || request.auth.uid in resource.data.get('access', []) || folderGranted());
      // A new document is not routed, shared or archived yet.
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('office', '') == myOffice()
        && request.resource.data.get('restricted', true) == false
        && !request.resource.data.keys().hasAny(['workflow', 'currentOffice', 'atPreparer', 'routeOffices', 'sharedWith', 'archive', 'reviews', 'access', 'editors']);
      // The preparer moves the route only one step on (release), back (return) or cancels it; and
      // marks it processed only from its last step.
      function preparerRouteOk() {
        return !('workflow' in request.resource.data)
          || (request.resource.data.workflow.state in ['in-progress', 'cancelled']
              && request.resource.data.workflow.stage <= resource.data.get('workflow', {}).get('stage', 0) + 1)
          || (request.resource.data.workflow.state == 'done' && 'workflow' in resource.data
              && resource.data.workflow.stage == resource.data.workflow.steps.size() - 1);
      }
      // History, reviews, a route's events, PDF versions: entries are only added, never changed or
      // removed (the record of who did what stays whole).
      function appendedList(before, after) {
        return after.size() >= before.size() && (before.size() == 0 || after[0:before.size()] == before);
      }
      function appended(key) {
        return appendedList(resource.data.get(key, []), request.resource.data.get(key, []));
      }
      function pdfAppended() {
        return appendedList(resource.data.get('pdf', {}).get('files', []), request.resource.data.get('pdf', {}).get('files', []));
      }
      // The route keeps its record: events are only added, and its steps stay those it started with
      // (the preparer chooses alternate offices and third parties before it first leaves the
      // office: routeOffices holds only that office then).
      function routeRecordKept() {
        let w0 = resource.data.get('workflow', {});
        let w1 = request.resource.data.get('workflow', {});
        return !('workflow' in resource.data)
          || (appendedList(w0.get('events', []), w1.get('events', []))
              && (w1.get('steps', []) == w0.get('steps', []) || resource.data.get('routeOffices', []).size() <= 1));
      }
      // The office holding it (or the person it is with) moves it one step on or back, or closes it
      // at its last step; never further, never back to an earlier office in one go.
      function routeMoveOk() {
        let w0 = resource.data.workflow;
        let w1 = request.resource.data.workflow;
        return w1.stage >= w0.stage - 1 && w1.stage <= w0.stage + 1
          && (w1.state == 'in-progress'
              || (w1.state == 'done' && w1.stage == w0.stage && w0.stage == w0.steps.size() - 1));
      }
      allow update: if isActive()
        && unchanged(['createdBy', 'createdAt', 'typeId', 'controlNo', 'typeSnapshot', 'office'])
        && referralAllowed()
        && (isAdmin()
            // The Records Officer files a processed document in the Archive (where it is kept).
            || (isRecords() && resource.data.get('workflow', {}).get('state', '') == 'done' && appended('history')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archive', 'updatedAt', 'history']))
            // The head of the office that prepared it (or the Records Officer) gives people of the
            // office access to it (viewer, or editor: also in editors), takes it back, or restricts
            // it (no access through folders).
            || (((isHead() && resource.data.get('office', '') == myOffice()) || isRecords()) && appended('history')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access', 'editors', 'restricted', 'history'])
                && request.resource.data.get('restricted', false) is bool
                && request.resource.data.get('access', []).hasAll(request.resource.data.get('editors', [])))
            // Someone it was sent to for review writes their review (nothing else).
            || (request.auth.uid in resource.data.get('sharedWith', [])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'updatedAt', 'history'])
                && appended('reviews') && appended('history'))
            // The person it is referred to receives it, signs its PDF and sends it back.
            || (referredToMe()
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['workflow', 'currentOffice', 'routeOffices', 'atPreparer', 'pdf', 'updatedAt', 'history', 'supplements'])
                && appended('history') && pdfAppended() && routeRecordKept() && routeMoveOk())
            // The preparer (or an editor) edits the document; its route only while it is with their
            // office (or before it is routed).
            // Not once processed (it is in the Archive), and never the archive entry, reviews or access.
            || (actsAsPreparer() && resource.data.status != 'cancelled'
                && resource.data.get('workflow', {}).get('state', '') != 'done'
                && unchanged(['archive', 'reviews', 'access', 'editors', 'restricted'])
                && appended('history') && pdfAppended() && routeRecordKept()
                && (workflowUntouched()
                    || ((!('workflow' in resource.data)
                        || (resource.data.workflow.state == 'in-progress' && (holder() == '' || holder() == myOffice())))
                      && preparerRouteOk())))
            // The office holding a routed document receives, releases or returns it, and signs its PDF.
            // (Its office head too, also at the preparer's step.) On receiving, it may assign a
            // reference no.: only the field (and date) its own route step assigns change.
            || ((heldByMyOffice() || (isHead() && holder() == myOffice()))
                && holdsStepPosition()
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['workflow', 'currentOffice', 'routeOffices', 'atPreparer', 'pdf', 'updatedAt', 'history', 'data', 'refNos', 'stepFiles', 'sharedWith', 'forwards', 'supplements', 'referred'])
                && request.resource.data.get('referred', []).hasAll(resource.data.get('referred', []))
                && appended('history') && pdfAppended() && routeRecordKept() && routeMoveOk()
                && request.resource.data.get('data', {}).diff(resource.data.get('data', {})).affectedKeys().hasOnly(assignedKeys())
                && request.resource.data.get('refNos', {}).diff(resource.data.get('refNos', {})).affectedKeys().hasOnly(assignedKeys())));
      // Only the superadmin deletes any document (administrators cannot). The preparer (or an
      // editor) deletes a draft: one never completed, or one routed and returned to their step and
      // saved as a draft again. Not while it is complete or out on its route.
      allow delete: if isSuper()
        || (isActive() && actsAsPreparer() && resource.data.status == 'draft'
            && (!('workflow' in resource.data)
                || (resource.data.workflow.state == 'in-progress' && resource.data.workflow.stage == 0
                    && resource.data.workflow.get('referral', null) == null)));
    }

    // ---- Folder access: the office head lets a user of the office read the office's documents of
    // chosen types (folders), or all of them. One per user, keyed by their uid.
    match /folderAccess/{uid} {
      // The office head; the Records Officer (and administrators) for every office.
      function headOf(o) {
        return (isOfficeHead() && myOffice() == o) || isRecords();
      }
      allow read: if isActive() && (request.auth.uid == uid || isAdmin() || headOf(resource.data.office));
      // office '*' (folders of every office, for anyone): administrators and the Records Officer only.
      allow create, update: if (isAdmin() || headOf(request.resource.data.office))
        && (resource == null || isAdmin() || headOf(resource.data.office))
        && request.resource.data.keys().hasOnly(['office', 'all', 'types', 'edit', 'name', 'by', 'byName', 'at'])
        && request.resource.data.all is bool && request.resource.data.get('edit', false) is bool && request.resource.data.types is list
        && (request.resource.data.office == '*'
            || get(/databases/$(database)/documents/users/$(uid)).data.get('office', '') == request.resource.data.office)
        && get(/databases/$(database)/documents/users/$(uid)).data.role != 'payee';
      allow delete: if isActive() && (isAdmin() || headOf(resource.data.office));
    }

    // ---- Restricted folders of an office: { restricted: [type codes] }, keyed by the office ----
    // No one gets at them through folder access; set by the office head, administrators and the
    // Records Officer.
    match /folderRules/{office} {
      allow read: if isActive();
      allow write: if isAdmin() || isRecords() || (isOfficeHead() && myOffice() == office);
    }

    // ---- Directory: names, offices, positions and pictures of active users (to forward a document to someone) ----
    // Each user keeps their own entry; administrators keep everyone's (so someone who has not
    // signed in since can still be found), from their profile, and remove inactive users'.
    match /directory/{uid} {
      // external: a supplier or payee
      allow read: if isActive();
      // position, idNo, photo: from My Profile (checked there).
      allow create, update: if isActive() && request.resource.data.keys().hasOnly(['displayName', 'office', 'email', 'external', 'position', 'idNo', 'photo'])
        && ((request.auth.uid == uid
              && request.resource.data.get('external', false) == (profile().role == 'payee')
              && request.resource.data.office == myOffice()
              && request.resource.data.get('email', '') in ['', request.auth.token.email]
              && request.resource.data.get('photo', '') == profile().get('photo', '')
              && request.resource.data.get('position', '') == profile().get('position', '')
              && request.resource.data.get('idNo', '') == profile().get('idNo', ''))
            || (isAdmin()
              && get(/databases/$(database)/documents/users/$(uid)).data.active == true
              && request.resource.data.get('external', false) == (get(/databases/$(database)/documents/users/$(uid)).data.role == 'payee')
              && request.resource.data.office == get(/databases/$(database)/documents/users/$(uid)).data.get('office', '')
              && request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.get('email', '')));
      allow delete: if isAdmin();
    }

    // ---- Verification records ----
    // One per PDF version DMS stored, keyed by the file's SHA-256: anyone holding a copy can
    // check it (Verify page, no sign-in). They can be read one at a time, never listed.
    match /verifications/{hash} {
      allow get: if true;
      allow list: if false;
      // Only for the PDF just added to a document, in the same write (its fingerprint is that file's).
      function docAdded() {
        return getAfter(/databases/$(database)/documents/documents/$(request.resource.data.docId)).data;
      }
      allow create: if isActive() && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['docId', 'controlNo', 'typeCode', 'typeName', 'version', 'kind', 'signer', 'signatures', 'by', 'at'])
        && request.resource.data.docId is string
        && docAdded().pdf.files[docAdded().pdf.files.size() - 1].sha256 == hash
        && request.resource.data.controlNo == docAdded().controlNo
        && request.resource.data.version == docAdded().pdf.files.size();
      allow update, delete: if false;
    }

    // ---- Public record of a document (what the QR code on its PDF opens) ----
    // Anyone, signed in or not, can read one by its id (the document's id, in the QR code); they
    // can never be listed. Written with each PDF version and workflow step by whoever may act on
    // the document then (before or after the change), and only for that document.
    match /checks/{docId} {
      function docBefore() {
        return get(/databases/$(database)/documents/documents/$(docId)).data;
      }
      function docAfter() {
        return getAfter(/databases/$(database)/documents/documents/$(docId)).data;
      }
      function handles(d) {
        return d.createdBy == request.auth.uid
          || (myOffice() != '' && d.get('office', '') == myOffice() && request.auth.uid in d.get('editors', []))
          || (exists(/databases/$(database)/documents/folderAccess/$(request.auth.uid))
              && get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.get('edit', false) == true
              && (get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.office == '*'
                  || (myOffice() != '' && d.get('office', '') == myOffice()
                      && get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.office == myOffice())))
          || (myOffice() != '' && d.get('currentOffice', '') == myOffice() && d.get('atPreparer', true) == false)
          || d.get('currentOffice', '') == 'person:' + request.auth.uid
          || (myOffice() != '' && profile().get('head', false) == true && d.get('office', '') == myOffice());
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if isActive()
        && request.resource.data.keys().hasOnly(['controlNo', 'typeCode', 'typeName', 'title', 'office', 'status', 'state', 'now', 'steps', 'signatures', 'versions', 'refNos', 'pdf', 'updatedAt'])
        && request.resource.data.controlNo == docAfter().controlNo
        // What it says matches the document: its status, and its current PDF (no earlier,
        // private version made public).
        && request.resource.data.get('status', '') == docAfter().get('status', '')
        && (request.resource.data.get('pdf', '') == ''
            || request.resource.data.pdf == docAfter().pdf.files[docAfter().pdf.files.size() - 1].path)
        && (isAdmin() || handles(docBefore()) || handles(docAfter()));
      // With the document: by an administrator, or by its preparer while it is a draft (deleted
      // together, in one batch).
      allow delete: if isAdmin()
        || (isActive() && exists(/databases/$(database)/documents/documents/$(docId))
            && get(/databases/$(database)/documents/documents/$(docId)).data.status == 'draft'
            && handles(get(/databases/$(database)/documents/documents/$(docId)).data));
    }

    // ---- Control number sequences ----
    match /counters/{counterId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.value == 1;
      allow update: if isStaff() && request.resource.data.value == resource.data.value + 1;
      allow delete: if isSuper();
    }
  }
}
