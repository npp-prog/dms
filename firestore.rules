        || (isActive() && actsAsPreparer() && resource.data.status == 'draft'
            && (!('workflow' in resource.data)
                || (resource.data.workflow.state == 'in-progress' && resource.data.workflow.stage == 0
                    && resource.data.workflow.get('referral', null) == null)));
    }

    // ---- Folder access: the office head lets a user of the office read the office's documents of
    // chosen types (folders), or all of them. One per user, keyed by their uid.
    match /folderAccess/{uid} {
      // The office head; the Records Officer (and administrators) for every office.
      function headOf(o) {
        return (isOfficeHead() && myOffice() == o) || isRecords();
      }
      // Office heads also see who has access to the folders of every office (to show it, not change it).
      allow read: if isActive() && (request.auth.uid == uid || isAdmin() || headOf(resource.data.office)
        || (isOfficeHead() && resource.data.office == '*'));
      // office '*' (folders of every office, for anyone): administrators and the Records Officer only.
      allow create, update: if (isAdmin() || headOf(request.resource.data.office))
        && (resource == null || isAdmin() || headOf(resource.data.office))
        && request.resource.data.keys().hasOnly(['office', 'all', 'types', 'edit', 'name', 'by', 'byName', 'at'])
        && request.resource.data.all is bool && request.resource.data.get('edit', false) is bool && request.resource.data.types is list
        && (request.resource.data.office == '*'
            || get(/databases/$(database)/documents/users/$(uid)).data.get('office', '') == request.resource.data.office)
        && get(/databases/$(database)/documents/users/$(uid)).data.role != 'payee';
      allow delete: if isActive() && (isAdmin() || headOf(resource.data.office));
    }

    // ---- Restricted folders of an office: { restricted: [type codes] }, keyed by the office ----
    // No one gets at them through folder access; set by the office head, administrators and the
    // Records Officer.
    match /folderRules/{office} {
      allow read: if isActive();
      allow write: if isAdmin() || isRecords() || (isOfficeHead() && myOffice() == office);
    }

    // ---- Directory: names, offices, positions and pictures of active users (to forward a document to someone) ----
    // Each user keeps their own entry; administrators keep everyone's (so someone who has not
    // signed in since can still be found), from their profile, and remove inactive users'.
    match /directory/{uid} {
      // external: a supplier or payee
      allow read: if isActive();
      // position, idNo, photo: from My Profile (checked there).
      // emailOff: the user turned off DMS emails (My Profile: emailNotify false in their profile).
      allow create, update: if isActive() && request.resource.data.keys().hasOnly(['displayName', 'office', 'email', 'external', 'position', 'idNo', 'photo', 'accountNo', 'head', 'positions', 'emailOff'])
        && ((request.auth.uid == uid
              && request.resource.data.get('external', false) == (profile().role == 'payee')
              && request.resource.data.office == myOffice()
              && request.resource.data.get('email', '') in ['', request.auth.token.email]
              && request.resource.data.get('photo', '') == profile().get('photo', '')
              && request.resource.data.get('position', '') == profile().get('position', '')
              && request.resource.data.get('idNo', '') == profile().get('idNo', '')
              && request.resource.data.get('accountNo', '') == profile().get('accountNo', '')
              && request.resource.data.get('head', false) == (profile().role != 'payee' && profile().get('head', false))
              && request.resource.data.get('positions', []) == profile().get('positions', [])
              && request.resource.data.get('emailOff', false) == (profile().get('emailNotify', true) == false))
            || (isAdmin()
              && get(/databases/$(database)/documents/users/$(uid)).data.active == true
              && request.resource.data.get('external', false) == (get(/databases/$(database)/documents/users/$(uid)).data.role == 'payee')
              && request.resource.data.office == get(/databases/$(database)/documents/users/$(uid)).data.get('office', '')
              && request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.get('email', '')
              && request.resource.data.get('accountNo', '') == get(/databases/$(database)/documents/users/$(uid)).data.get('accountNo', '')
              && request.resource.data.get('head', false) == (get(/databases/$(database)/documents/users/$(uid)).data.role != 'payee' && get(/databases/$(database)/documents/users/$(uid)).data.get('head', false))
              && request.resource.data.get('positions', []) == get(/databases/$(database)/documents/users/$(uid)).data.get('positions', [])
              && request.resource.data.get('emailOff', false) == (get(/databases/$(database)/documents/users/$(uid)).data.get('emailNotify', true) == false)));
      allow delete: if isAdmin();
    }

    // ---- Verification records ----
    // One per PDF version DMS stored, keyed by the file's SHA-256: anyone holding a copy can
    // check it (Verify page, no sign-in). They can be read one at a time, never listed.
    match /verifications/{hash} {
      allow get: if true;
      allow list: if false;
      // Only for the PDF just added to a document, in the same write (its fingerprint is that file's).
      function docAdded() {
        return getAfter(/databases/$(database)/documents/documents/$(request.resource.data.docId)).data;
      }
      allow create: if isActive() && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['docId', 'controlNo', 'typeCode', 'typeName', 'version', 'kind', 'signer', 'signatures', 'by', 'at'])
        && request.resource.data.docId is string
        && docAdded().pdf.files[docAdded().pdf.files.size() - 1].sha256 == hash
        && request.resource.data.controlNo == docAdded().controlNo
        && request.resource.data.version == docAdded().pdf.files.size()
        // What it says is what the document and the file just added say.
        && request.resource.data.get('typeName', '') == docAdded().get('typeName', '')
        && request.resource.data.get('kind', '') == docAdded().pdf.files[docAdded().pdf.files.size() - 1].get('kind', '');
      allow update, delete: if false;
    }

    // ---- Public record of a document (what the QR code on its PDF opens) ----
    // Anyone, signed in or not, can read one by its id (the document's id, in the QR code); they
    // can never be listed. Written with each PDF version and workflow step by whoever may act on
    // the document then (before or after the change), and only for that document.
    match /checks/{docId} {
      function docBefore() {
        return get(/databases/$(database)/documents/documents/$(docId)).data;
      }
      function docAfter() {
        return getAfter(/databases/$(database)/documents/documents/$(docId)).data;
      }
      function handles(d) {
        return d.createdBy == request.auth.uid
          || (myOffice() != '' && d.get('office', '') == myOffice() && request.auth.uid in d.get('editors', []))
          || (exists(/databases/$(database)/documents/folderAccess/$(request.auth.uid))
              && get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.get('edit', false) == true
              && (get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.office == '*'
                  || (myOffice() != '' && d.get('office', '') == myOffice()
                      && get(/databases/$(database)/documents/folderAccess/$(request.auth.uid)).data.office == myOffice())))
          || (myOffice() != '' && d.get('currentOffice', '') == myOffice() && d.get('atPreparer', true) == false)
          || d.get('currentOffice', '') == 'person:' + request.auth.uid
          || request.auth.uid in d.get('signers', [])
          || (myOffice() != '' && profile().get('head', false) == true && d.get('office', '') == myOffice());
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if isActive()
        && request.resource.data.keys().hasOnly(['controlNo', 'typeCode', 'typeName', 'title', 'office', 'status', 'state', 'now', 'steps', 'signatures', 'versions', 'refNos', 'pdf', 'updatedAt'])
        && request.resource.data.controlNo == docAfter().controlNo
        // What it says matches the document: its status, and its current PDF (no earlier,
        // private version made public).
        && request.resource.data.get('status', '') == docAfter().get('status', '')
        && (request.resource.data.get('pdf', '') == ''
            || request.resource.data.pdf == docAfter().pdf.files[docAfter().pdf.files.size() - 1].path)
        && (isAdmin() || handles(docBefore()) || handles(docAfter()));
      // With the document: by an administrator, or by its preparer while it is a draft (deleted
      // together, in one batch).
      allow delete: if isAdmin()
        || (isActive() && exists(/databases/$(database)/documents/documents/$(docId))
            && get(/databases/$(database)/documents/documents/$(docId)).data.status == 'draft'
            && handles(get(/databases/$(database)/documents/documents/$(docId)).data));
    }

    // ---- Work management: boards and work items (docs/work-management-integration.md) ----
    // A board's managers change its settings and people; its members create, edit and assign work
    // items; its viewers read. access = all of them. Administrators see every board. Seeing a board
    // gives no access to the DMS documents its items link: an item keeps only their ids, and each
    // document's own rules decide who opens it.
    function boardOf(id) {
      return get(/databases/$(database)/documents/boards/$(id)).data;
    }
    // The head of the office a board belongs to (board.office): sees it, and may delete it.
    function headsBoardOffice(b) {
      return b.get('office', '') != '' && isOfficeHead() && b.get('office', '') == myOffice();
    }
    // Everyone of the board's office sees it (and its work items), as viewers; its people and the
    // office head do more (editsBoard, managesBoard).
    function seesBoard(b) {
      return isAdmin() || request.auth.uid in b.get('access', []) || headsBoardOffice(b)
        || (b.get('office', '') != '' && myOffice() == b.get('office', ''));
    }
    // (An archived board is read-only: no work items are added or edited until it is restored.)
    function editsBoard(b) {
      return !b.get('archived', false) && (isAdmin() || request.auth.uid in b.get('managers', []) || request.auth.uid in b.get('members', [])
        || headsBoardOffice(b));
    }
    // The head of a board's office: archives or restores it, and sets its card color; nothing else.
    function headBoardChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy', 'color', 'updatedAt'])
        && request.resource.data.get('archived', false) is bool
        && (request.resource.data.get('archivedBy', '') == resource.data.get('archivedBy', '')
            || request.resource.data.get('archivedBy', '') in ['', request.auth.uid]);
    }
    // Archiving or restoring: only the archive fields change.
    function onlyArchiving() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy', 'updatedAt'])
        && request.resource.data.archived is bool && request.resource.data.get('archivedBy', '') in ['', request.auth.uid];
    }
    // (The head of a board's office manages it like its managers do, without being on it.)
    function managesBoard(b) {
      return isAdmin() || request.auth.uid in b.get('managers', []) || b.get('ownerUid', '') == request.auth.uid || headsBoardOffice(b);
    }
    function boardShapeOk(d) {
      return d.keys().hasOnly(['name', 'description', 'template', 'office', 'ownerUid', 'ownerName', 'managers', 'members',
          'viewers', 'access', 'names', 'groups', 'archived', 'createdAt', 'updatedAt', 'columns', 'exportBy', 'reminders',
          'archivedAt', 'archivedBy', 'color'])
        && d.get('archived', false) is bool
        && d.get('color', '') in ['', 'blue', 'green', 'teal', 'yellow', 'orange', 'red', 'pink', 'purple', 'gray']
        && d.get('columns', []) is list && d.get('columns', []).size() <= 20
        && d.get('exportBy', 'members') in ['members', 'managers', 'everyone']
        && d.get('reminders', true) is bool
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.managers is list && d.members is list && d.viewers is list && d.access is list
        && d.access.size() <= 200 && d.groups is list && d.groups.size() <= 30
        && d.access.hasAll(d.managers) && d.access.hasAll(d.members) && d.access.hasAll(d.viewers)
        && d.access.size() <= d.managers.size() + d.members.size() + d.viewers.size();
    }
    match /boards/{boardId} {
      allow read: if isStaff() && seesBoard(resource.data);
      allow create: if isStaff() && boardShapeOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.managers;
      // Its managers; the head of its office may archive or restore it.
      allow update: if isStaff() && (managesBoard(resource.data) || (headsBoardOffice(resource.data) && headBoardChange()))
        && boardShapeOk(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isStaff() && (isAdmin() || resource.data.ownerUid == request.auth.uid || headsBoardOffice(resource.data));

      // Saved views: each person's own (by them), or shared with the board by a manager. Never
      // changed: saved again, or deleted by whoever saved it (shared ones: a manager too).
      match /views/{viewId} {
        function vboard() {
          return get(/databases/$(database)/documents/boards/$(boardId)).data;
        }
        allow read: if isStaff() && seesBoard(vboard()) && (resource.data.by == request.auth.uid || resource.data.shared == true);
        allow create: if isStaff() && seesBoard(vboard())
          && request.resource.data.keys().hasOnly(['name', 'shared', 'by', 'byName', 'at', 'view', 'status', 'sort', 'mine', 'q', 'office'])
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && request.resource.data.q is string && request.resource.data.q.size() <= 100
          && request.resource.data.shared is bool && (request.resource.data.shared == false || managesBoard(vboard()));
        allow update: if false;
        allow delete: if isStaff() && (resource.data.by == request.auth.uid || (resource.data.shared == true && managesBoard(vboard())));
      }
    }
    // A work item: on one board (boardId, never changed). Its status is the task's progress only:
    // it approves, routes or pays nothing in the DMS.
    function itemShapeOk(d, b) {
      return d.keys().hasOnly(['boardId', 'groupId', 'title', 'description', 'status', 'priority', 'assignees', 'assigneeNames',
          'office', 'startDate', 'dueDate', 'completedOn', 'tags', 'docRefs', 'createdBy', 'createdByName', 'createdAt',
          'updatedAt', 'updatedBy', 'checklist', 'parentId', 'projectId', 'fields'])
        && d.get('fields', {}) is map && d.get('fields', {}).size() <= 40
        && d.get('checklist', []) is list && d.get('checklist', []).size() <= 50
        && d.get('parentId', '') is string
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.get('description', '') is string && d.get('description', '').size() <= 4000
        && d.status in ['not_started', 'in_progress', 'blocked', 'for_review', 'done']
        && d.priority in ['low', 'medium', 'high', 'urgent']
        && d.assignees is list && d.assignees.size() <= 20
        && b.get('access', []).hasAll(d.assignees)
        && d.docRefs is list && d.docRefs.size() <= 50
        && d.tags is list && d.tags.size() <= 10
        && d.updatedBy == request.auth.uid;
    }
    match /workItems/{itemId} {
      // Its board's people, its assignees and whoever created it.
      allow read: if isStaff() && (request.auth.uid in resource.data.assignees || resource.data.createdBy == request.auth.uid
        || seesBoard(boardOf(resource.data.boardId)));
      allow create: if isStaff() && editsBoard(boardOf(request.resource.data.boardId))
        && itemShapeOk(request.resource.data, boardOf(request.resource.data.boardId))
        && request.resource.data.createdBy == request.auth.uid;
      // The board's members edit it; an assignee who is not one changes only its status.
      allow update: if isStaff()
        && request.resource.data.boardId == resource.data.boardId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && itemShapeOk(request.resource.data, boardOf(resource.data.boardId))
        && (editsBoard(boardOf(resource.data.boardId))
            || (request.auth.uid in resource.data.assignees && !boardOf(resource.data.boardId).get('archived', false)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedOn', 'checklist', 'updatedAt', 'updatedBy'])));
      // (Its creator, the board's managers, and whoever may delete the board: its items go with it.)
      allow delete: if isStaff() && (resource.data.createdBy == request.auth.uid || managesBoard(boardOf(resource.data.boardId))
        || boardOf(resource.data.boardId).get('ownerUid', '') == request.auth.uid || headsBoardOffice(boardOf(resource.data.boardId)));

      // The item's timeline: added to by whoever may act on the item, as themselves, at the server's
      // time; never changed or removed.
      match /activity/{eventId} {
        function item() {
          return get(/databases/$(database)/documents/workItems/$(itemId)).data;
        }
        allow read: if isStaff() && (request.auth.uid in item().assignees || item().createdBy == request.auth.uid
          || seesBoard(boardOf(item().boardId)));
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['type', 'text', 'by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && (editsBoard(boardOf(getAfter(/databases/$(database)/documents/workItems/$(itemId)).data.boardId))
              || request.auth.uid in getAfter(/databases/$(database)/documents/workItems/$(itemId)).data.assignees);
        allow update, delete: if false;
      }
      // Comments: whoever may see the item writes them, as themselves, at the server's time, naming
      // whom they mention (people on the board); never changed or removed.
      match /comments/{commentId} {
        function citem() {
          return get(/databases/$(database)/documents/workItems/$(itemId)).data;
        }
        function seesItem() {
          return request.auth.uid in citem().assignees || citem().createdBy == request.auth.uid || seesBoard(boardOf(citem().boardId));
        }
        allow read: if isStaff() && seesItem();
        allow create: if isStaff() && seesItem() && !boardOf(citem().boardId).get('archived', false)
          && request.resource.data.keys().hasOnly(['text', 'mentions', 'by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.mentions is list && request.resource.data.mentions.size() <= 20
          && boardOf(citem().boardId).get('access', []).hasAll(request.resource.data.mentions);
        allow update, delete: if false;
      }
    }

    // ---- Projects (work management, Phase 3) ----
    // Managers change the project's details, people and approved budget; members keep its
    // milestones, links, status and progress (with an explanation); viewers read. Seeing a project
    // opens none of the DMS documents it links (ids only).
    // The head of a project's implementing office sees it and may archive or restore it.
    function headsProjectOffice(p) {
      return p.get('office', '') != '' && isOfficeHead() && p.get('office', '') == myOffice();
    }
    function seesProject(p) {
      return isAdmin() || request.auth.uid in p.get('access', []) || headsProjectOffice(p);
    }
    // (An archived project is read-only until it is restored.)
    function editsProject(p) {
      return !p.get('archived', false) && (isAdmin() || request.auth.uid in p.get('managers', []) || request.auth.uid in p.get('members', []));
    }
    function managesProject(p) {
      return isAdmin() || request.auth.uid in p.get('managers', []) || p.get('ownerUid', '') == request.auth.uid;
    }
    function projectShapeOk(d) {
      return d.keys().hasOnly(['code', 'name', 'description', 'office', 'startDate', 'targetDate', 'status', 'fundingSource',
          'approvedBudget', 'ownerUid', 'ownerName', 'managers', 'members', 'viewers', 'access', 'names', 'milestones',
          'docRefs', 'boardIds', 'physicalProgress', 'progressNote', 'progressAt', 'createdAt', 'updatedAt',
          'archived', 'archivedAt', 'archivedBy'])
        && d.get('archived', false) is bool
        && d.code is string && d.code.size() > 0 && d.code.size() <= 30
        && d.name is string && d.name.size() > 0 && d.name.size() <= 160
        && d.status in ['planning', 'ongoing', 'on_hold', 'completed', 'cancelled']
        && (d.approvedBudget == null || (d.approvedBudget is number && d.approvedBudget >= 0))
        && d.physicalProgress is number && d.physicalProgress >= 0 && d.physicalProgress <= 100
        && d.milestones is list && d.milestones.size() <= 50
        && d.docRefs is list && d.docRefs.size() <= 100 && d.boardIds is list && d.boardIds.size() <= 30
        && d.managers is list && d.members is list && d.viewers is list && d.access is list && d.access.size() <= 200
        && d.access.hasAll(d.managers) && d.access.hasAll(d.members) && d.access.hasAll(d.viewers)
        && d.access.size() <= d.managers.size() + d.members.size() + d.viewers.size();
    }
    match /projects/{projectId} {
      allow read: if isStaff() && seesProject(resource.data);
      allow create: if isStaff() && projectShapeOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.auth.uid in request.resource.data.managers
        && request.resource.data.physicalProgress == 0;
      // Physical progress changes only with its explanation (a progress update, same batch).
      allow update: if isStaff() && projectShapeOk(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.physicalProgress == resource.data.physicalProgress
            || (request.resource.data.progressNote is string && request.resource.data.progressNote.size() >= 5
                && request.resource.data.progressNote != resource.data.progressNote))
        && ((managesProject(resource.data) && (!resource.data.get('archived', false) || onlyArchiving()))
            || (headsProjectOffice(resource.data) && onlyArchiving())
            || (editsProject(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['milestones', 'docRefs', 'boardIds', 'status', 'physicalProgress', 'progressNote', 'progressAt', 'updatedAt'])));
      allow delete: if isStaff() && (isAdmin() || resource.data.ownerUid == request.auth.uid);

      function proj() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }
      // Risks, issues and blockers: kept by those who edit the project; removed by its managers.
      match /issues/{issueId} {
        allow read: if isStaff() && seesProject(proj());
        allow create: if isStaff() && editsProject(proj())
          && request.resource.data.keys().hasOnly(['type', 'title', 'description', 'severity', 'owner', 'status', 'createdBy',
              'createdByName', 'createdAt', 'resolvedOn', 'updatedBy'])
          && request.resource.data.type in ['risk', 'issue', 'blocker'] && request.resource.data.severity in ['low', 'medium', 'high']
          && request.resource.data.status == 'open' && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200;
        allow update: if isStaff() && editsProject(proj())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedOn', 'updatedBy'])
          && request.resource.data.status in ['open', 'resolved'] && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isStaff() && managesProject(proj());
      }
      // Progress updates: the physical progress and why, as the person who wrote it, at the server's
      // time; never changed or removed.
      match /updates/{updateId} {
        allow read: if isStaff() && seesProject(proj());
        allow create: if isStaff() && editsProject(proj())
          && request.resource.data.keys().hasOnly(['physical', 'note', 'by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.physical is int && request.resource.data.physical >= 0 && request.resource.data.physical <= 100
          && request.resource.data.note is string && request.resource.data.note.size() >= 5 && request.resource.data.note.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ---- Where a document of a link-once type is linked (document type: linkOnce) ----
    // One per linked document: the document it is linked to. Taken when it is linked (refused if
    // taken by another document), given back when it is unlinked or that document is deleted.
    match /linkClaims/{targetId} {
      allow read: if isActive();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['parent', 'parentControlNo', 'by', 'at'])
        && request.resource.data.parent is string;
      // Kept by the same document; or taken over when that document no longer exists.
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['parent', 'parentControlNo', 'by', 'at'])
        && (request.resource.data.parent == resource.data.parent
            || !exists(/databases/$(database)/documents/documents/$(resource.data.parent)));
      allow delete: if isStaff();
    }

    // ---- Control number sequences ----
    match /counters/{counterId} {
      allow read: if isStaff();
      // A reference no.'s series (…_REF_…): it moves only with the document given that number, in
      // the same write (refNos[field]: { counter, seq }, see documents refAssignOk).
      function refCounterOk() {
        return !counterId.matches('.*REF_.*')
          || (request.resource.data.keys().hasOnly(['value', 'doc', 'field'])
              && request.resource.data.doc is string && request.resource.data.field is string
              && getAfter(/databases/$(database)/documents/documents/$(request.resource.data.doc)).data.get('refNos', {}).get(request.resource.data.field, {}).get('counter', '') == counterId
              && getAfter(/databases/$(database)/documents/documents/$(request.resource.data.doc)).data.get('refNos', {}).get(request.resource.data.field, {}).get('seq', -1) == request.resource.data.value);
      }
      allow create: if isStaff() && request.resource.data.value == 1 && refCounterOk();
      allow update: if isStaff() && request.resource.data.value == resource.data.value + 1 && refCounterOk();
      allow delete: if isSuper();
    }
  }
}
