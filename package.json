{
  "name": "fts",
  "private": true,
  "version": "1.0.0",
  "description": "FTS - Financial Transaction System: repository of LGU financial document formats with guided, checklist-based preparation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "node scripts/local.mjs",
    "local:reset": "node -e \"require('fs').rmSync('.emulator-data',{recursive:true,force:true});console.log('Local data cleared.')\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.js netlify/lib/*.test.mjs",
    "emulators": "npx -y firebase-tools@15.34.1 emulators:start --only auth,firestore --project demo-fts",
    "deploy:rules": "npx -y firebase-tools@15.34.1 deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@signpdf/utils": "3.3.0",
    "buffer": "6.0.3",
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.14",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "node-forge": "1.4.0",
    "nodemailer": "^6.9.16",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "jsqr": "1.4.0",
    "vite": "^5.4.21"
  },
  "overrides": {
    "@signpdf/utils": "3.3.0",
    "@signpdf/placeholder-pdfkit010": "3.3.0",
    "node-forge": "1.4.0"
  }
}
